# Server
PORT=4001
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS (required in production)
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# LLM provider — store in AWS Secrets Manager for ECS, not in plain text
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here
# Model — flash-lite has the most generous free-tier limits; flash is smarter but
# capped at ~20 free requests (each chat turn uses 2+ requests in the tool loop).
# GEMINI_MODEL=gemini-flash-lite-latest

# Rate limit for POST /api/chat (per IP + X-Tenant-ID)
# CHAT_RATE_LIMIT_MAX=30
# CHAT_RATE_LIMIT_WINDOW_MS=900000

# Client (build-time only — baked into Vite bundle)
# Leave empty when CloudFront serves client + proxies /api to ALB (same-origin)
# VITE_API_URL=https://api.example.com
